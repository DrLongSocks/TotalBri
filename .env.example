NEXT_PUBLIC_WHATSAPP_PRIMARY=525346880969
NEXT_PUBLIC_WHATSAPP_SECONDARY=525341349764
NEXT_PUBLIC_SITE_URL=https://totalbri.mx

# Admin dashboard (served at /admin on this same deployment) — server-only, see src/lib/env.server.ts
DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host.neon.tech/dbname?sslmode=require
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Sent via Gmail SMTP (nodemailer) — GMAIL_USER doubles as both the SMTP
# auth username and the "from" address. GMAIL_APP_PASSWORD is a Google
# Account > Security > App Passwords value, not the account's real password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
LOW_STOCK_ALERT_EMAIL_PRIMARY=
LOW_STOCK_ALERT_EMAIL_SECONDARY=

# Invoice PDF import (app/admin/materials/import) — Claude extracts line
# items, Vercel Blob stores the original PDF
ANTHROPIC_API_KEY=
BLOB_READ_WRITE_TOKEN=

# db:seed only — creates the first admin account directly, never committed with a real value
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
